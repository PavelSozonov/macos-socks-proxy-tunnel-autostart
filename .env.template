# SSH connection settings
SSH_USER=username
SSH_SERVER=your-server.com
SSH_KEY_FILE=~/.ssh/id_ed25519

# SOCKS proxy port (default: 8090)
SOCKS_PORT=8090

# HTTP proxy port via gost (default: 8118)
# Pre-requisite: brew install gost
# Forwards http://127.0.0.1:GOST_HTTP_PORT → socks5://127.0.0.1:SOCKS_PORT
GOST_HTTP_PORT=8118
# Bind address for the bridge.  Keep it on loopback: the bridge has no
# authentication, so 0.0.0.0 (or an empty host) makes an open proxy on the LAN.
GOST_BIND=127.0.0.1
# gost log level.  At "info" it logs a line per proxied request, including the
# destination host; "warn" leaves only failures (7% of the volume, measured).
GOST_LOG_LEVEL=warn

# Watchdog: end-to-end health check through the SOCKS proxy (make install-watchdog)
# Restarts the tunnel when the check fails WATCHDOG_FAILURES times in a row
WATCHDOG_INTERVAL=3
WATCHDOG_INTERVAL_BATTERY=60
WATCHDOG_URL=https://www.google.com/generate_204
WATCHDOG_FAILURES=2
WATCHDOG_TIMEOUT=3

# Log size cap (make install-log-cap).  gost logs one line per proxied request,
# so without a cap its log grows without bound — it was once found at 3.3 GB.
# Each service log is truncated in place once it passes LOG_CAP_BYTES.
LOG_CAP_BYTES=104857600
LOG_CAP_INTERVAL=300
# Lines preserved into <log>.prev right before a truncation (0 to keep none)
LOG_CAP_KEEP_LINES=2000
